<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= botName %> | لوحة التحكم والحماية</title>
    <style>
        :root {
            --bg-color: #0f1117;
            --card-bg: #161b22;
            --accent-color: #5865f2;
            --text-main: #c9d1d9;
            --text-muted: #8b949e;
            --border-color: #30363d;
            --success: #2ea043;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 1100px;
            margin: 0 auto;
        }
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 15px;
            margin-bottom: 25px;
        }
        h1 { margin: 0; font-size: 24px; color: #fff; }
        .badge {
            background: var(--accent-color);
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 14px;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }
        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .card h3 { margin: 0 0 10px 0; color: var(--text-muted); font-size: 14px; }
        .card .value { font-size: 22px; font-weight: bold; color: #fff; }
        .logs-section {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px;
        }
        .logs-section h2 { margin-top: 0; font-size: 18px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; }
        .log-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid rgba(48, 54, 61, 0.5);
            font-family: monospace;
            font-size: 13px;
        }
        .log-time { color: var(--text-muted); }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🛡️ <%= botName %> Dashboard</h1>
            <span class="badge">متصل وحماية نشطة</span>
        </header>

        <div class="stats-grid">
            <div class="card">
                <h3>السيرفرات المحمية</h3>
                <div class="value"><%= guildsCount %> سيرفر</div>
            </div>
            <div class="card">
                <h3>حالة النظام</h3>
                <div class="value" style="color: var(--success);">يعمل بكفاءة 24/7</div>
            </div>
        </div>

        <div class="logs-section">
            <h2>سجلات الأحداث الحية (Live Protection Logs)</h2>
            <div id="logs-container">
                <% if (logs.length === 0) { %>
                    <p style="color: var(--text-muted); text-align: center;">لا توجد أحداث مسجلة حتى الآن، النظام يراقب...</p>
                <% } else { %>
                    <% logs.forEach(log => { %>
                        <div class="log-item">
                            <span>[<%= log.type %>] <%= log.message %></span>
                            <span class="log-time"><%= log.timestamp %></span>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
